# Supabase PostgreSQL Database Credentials
DB_URL=jdbc:postgresql://your-supabase-host:5432/postgres?sslmode=require
DB_USERNAME=your_db_username
DB_PASSWORD=your_db_password

# Gmail SMTP Notification Gateway
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your_school_email@gmail.com
MAIL_PASSWORD=your_16_char_google_app_password

# Razorpay Payment Gateway Keys
RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
RAZORPAY_CURRENCY=INR
RAZORPAY_COMPANY_NAME=Royal International Public School

# Frontend Client URL
FRONTEND_URL=https://school-d2jr90fju-vikku232s-projects.vercel.app
